{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProjectYard",
  "version": "0.1.0",
  "identifier": "com.projectyard.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "ProjectYard",
      "width": 1180,
      "height": 780,
      "minWidth": 920,
      "minHeight": 640
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "DeveloperTool",
    "shortDescription": "A local-first developer project inventory",
    "longDescription": "ProjectYard discovers projects in folders you choose and presents a private local inventory through a desktop GUI and terminal UI.",
    "icon": ["icons/icon.png"]
  }
}
